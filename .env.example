# COP Backend Environment Configuration
# Copy this file to .env and fill in your PostgreSQL connection details

# PostgreSQL connection string (DATABASE_URL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://cop_user:cop_password@localhost:5432/cop_db

# Server port
PORT=3000

# API base URL (frontend will call this)
API_BASE_URL=http://localhost:3000